# Copy this file to .env and fill in values ONLY if you want the optional
# AI acknowledgement step. Leave TRIAGE_AI_PROVIDER unset (the default) and
# the prototype uses the deterministic templates and never sends data off
# the machine.
#
# groq   - free Groq API. This is the provider to demo.
# azure  - Azure OpenAI Service, used on its own, or as a fallback when groq is selected and these keys are set.
# openai - OpenAI, used on its own, or as a fallback after Azure when groq is selected and this key is set.
TRIAGE_AI_PROVIDER=groq

# --- Groq (free). Create a key at https://console.groq.com/keys ---
GROQ_API_KEY=
# Free-tier model. llama-3.3-70b-versatile was retired for free Groq use on 16 August 2026.
GROQ_MODEL=openai/gpt-oss-20b

# --- Azure OpenAI fallback (optional while TRIAGE_AI_PROVIDER=groq) ---
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI fallback (optional while TRIAGE_AI_PROVIDER=groq) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Request timeout in seconds for each provider (the template is used if all of them fail)
TRIAGE_AI_TIMEOUT=20
